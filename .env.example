# Local demo only. Change SMAIP_API_KEYS before exposing the port.
SMAIP_API_KEYS=dev-local-key
SMAIP_REQUIRE_API_KEY=true
SMAIP_RATE_LIMIT_PER_MINUTE=60
SMAIP_MAX_BODY_BYTES=65536
SMAIP_MAX_MESSAGE_CHARS=8000
SMAIP_MAX_MESSAGES=32
SMAIP_LOG_LEVEL=INFO

# Optional local open-model generation; no hosted-provider API key.
# SMAIP_OPEN_MODEL_ENABLE=1
# SMAIP_OPEN_MODEL_ID=Qwen/Qwen2.5-3B-Instruct
# SMAIP_OPEN_MODEL_REVISION=aa8e72537993ba99e69dfaafa59ed015b17504d1
# SMAIP_OPEN_MODEL_DEVICE=cuda
# SMAIP_OPEN_MODEL_DTYPE=float16
# SMAIP_VLLM_BASE_URL=http://127.0.0.1:8001/v1
