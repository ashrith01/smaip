      "instruction": "Prepare the vendor brief.",
      "fields": {"intent": "research", "vendor": "nimbus_notes", "recipient": "ops@acme.example"},
      "expect": {"summary_contains": ["3"], "sent_to": "ops@acme.example", "body_prefix": "mock:"},
      "follow": {
        "tool": "write",
        "pages": ["overview.md"],
        "arguments": {"path": "secret.txt", "content": "copied figures"}
